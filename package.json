{
  "name": "@kvnloo/dsh-tern",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone DSH/Cordis terminal bundle with Tern TSP and ANSI fallback",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/tern-LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kvnloo/dsh-tern.git"
  },
  "bugs": {
    "url": "https://github.com/kvnloo/dsh-tern/issues"
  },
  "homepage": "https://github.com/kvnloo/dsh-tern#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build:types": "tsc -p tsconfig.json",
    "build:bundle": "tsdown --config-loader native",
    "build": "pnpm run verify:patch && pnpm run verify:sdk-license && pnpm run clean && pnpm run build:types && pnpm run build:bundle",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run tests --exclude 'tests/host/tests/**'",
    "test:public:source": "node scripts/run-public.mjs src",
    "test:public:lib": "node scripts/run-public.mjs lib",
    "test:packed": "node tests/fixtures/verify-packed-sdk.mjs",
    "test:all": "pnpm run build && pnpm run typecheck && pnpm run test:unit && pnpm run test:public:source && pnpm run test:public:lib && pnpm run test:packed",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build",
    "verify:patch": "node scripts/verify-sdk-patch.mjs",
    "verify:sdk-license": "node scripts/copy-sdk-license.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8",
    "execa": "^10.0.0",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-cmdline": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-agent-default-model": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-loader-smoke": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@stencil-hq/tern": "0.1.0"
  }
}
